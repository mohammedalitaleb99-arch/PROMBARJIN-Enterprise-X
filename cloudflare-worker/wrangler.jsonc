{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "prombarjin-enterprise-x",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prombarjin-memory",
      "database_id": "REPLACE_AFTER_CREATING_D1"
    }
  ]
}
